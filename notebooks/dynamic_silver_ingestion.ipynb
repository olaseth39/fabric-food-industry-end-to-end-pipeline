def csv_to_silver_delta(file_path, target_lakehouse, schema_name, table_name):
    """
    Reads a raw CSV from the Files section (Bronze) and writes it 
    as a Delta table into a specific schema in the Silver Lakehouse.
    """
    df = spark.read.csv(file_path, header=True, inferSchema=True)
    spark.sql(f"CREATE SCHEMA IF NOT EXISTS {target_lakehouse}.{schema_name}")
    
    full_table_name = f"{target_lakehouse}.{schema_name}.{table_name}"
    
    # Add the overwriteSchema option here!
    df.write.option("overwriteSchema", "true").mode("overwrite").format("delta").saveAsTable(full_table_name)
    
    print(f"Created Silver table: {full_table_name}")
    return full_table_name


# ==========================================
# DYNAMIC EXECUTION (PROTECT DPRODUCT ONLY)
# ==========================================

# 1. Do not exclude any folders
EXCLUDED_FOLDERS = []

# 2. Exclude only the joined dproduct file
EXCLUDED_FILES = [
    "production/dproduct.csv"
]

base_path = "Files/Bronze_OneDrive/Documents"

# 3. Dynamically get all folders inside Documents
folders = mssparkutils.fs.ls(base_path)

for folder in folders:
    if folder.isDir:
        folder_name = folder.name.lower()
        
        # Check if the folder is in the exclusion list
        if folder_name in EXCLUDED_FOLDERS:
            print(f"SKIPPED FOLDER: {folder_name}")
            continue
            
        folder_path = folder.path
        print(f"\n--- Processing Folder: {folder_name} ---")
        
        files = mssparkutils.fs.ls(folder_path)
        
        for file in files:
            if file.name.endswith('.csv'):
                file_path = file.path
                
                # Check if the file is in the exclusion list
                check_name = f"{folder_name}/{file.name}"
                if check_name in EXCLUDED_FILES:
                    print(f"SKIPPED FILE: {file.name}")
                    continue
                
                # Clean up the table name
                table_name = file.name.replace('.csv', '').replace(' ', '_').replace('.', '').lower()
                
                # Call the function
                csv_to_silver_delta(file_path, "LH_Silver", folder_name, table_name)

print("Dynamic processing complete! 'dproduct' was safely skipped.")

# ==========================================
# DYNAMIC EXECUTION (WITH METADATA MANIFEST)
# ==========================================

EXCLUDED_FOLDERS = []
EXCLUDED_FILES = ["production/dproduct.csv"]

base_path = "Files/Bronze_OneDrive/Documents"
folders = mssparkutils.fs.ls(base_path)

# List to hold the table names we process
processed_tables = []

for folder in folders:
    if folder.isDir:
        folder_name = folder.name.lower()
        if folder_name in EXCLUDED_FOLDERS:
            continue
            
        folder_path = folder.path
        files = mssparkutils.fs.ls(folder_path)
        
        for file in files:
            if file.name.endswith('.csv'):
                file_path = file.path
                check_name = f"{folder_name}/{file.name}"
                if check_name in EXCLUDED_FILES:
                    continue
                
                table_name = file.name.replace('.csv', '').replace(' ', '_').replace('.', '').lower()
                
                # Call the function to write to Silver
                csv_to_silver_delta(file_path, "LH_Silver", folder_name, table_name)
                
                # ADD THE TABLE TO OUR MANIFEST LIST
                processed_tables.append((folder_name, table_name))

# SAVE THE MANIFEST LIST TO A DELTA TABLE IN THE LAKEHOUSE
# SAVE THE MANIFEST LIST TO A DELTA TABLE IN THE LAKEHOUSE
if processed_tables:
    # Create the metadata schema first!
    spark.sql("CREATE SCHEMA IF NOT EXISTS LH_Silver.metadata")
    
    metadata_df = spark.createDataFrame(processed_tables, ["SchemaName", "TableName"])
    metadata_df.write.option("overwriteSchema", "true").mode("overwrite").format("delta").saveAsTable("LH_Silver.metadata.processed_tables")

print("Silver processing complete. Metadata manifest saved!")
